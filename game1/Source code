int checkCollision()
{
    int dinoRight = x + x2 + ballx+60; // Rightmost coordinate of the dinosaur
    int dinoBottom = y + bally;    // Bottom coordinate of the dinosaur

   int obstacleRight1 = obcordx1 + obx1 + obstacleWidth1; // Rightmost coordinate of the obstacle
   int obstacleLeft1 =obcordx1+obx1;
    int obstacleTop1 = 465 + 150; // Top coordinate of the obstacle

     int obstacleRight2 = obcordx2 + obx2 + obstacleWidth2; // Rightmost coordinate of the obstacle
   int obstacleLeft2 =obcordx2+obx2;
    int obstacleTop2 = 465 + 150; // Top coordinate of the obstacle

     int obstacleRight3 = obcordx3 + obx3 + obstacleWidth3; // Rightmost coordinate of the obstacle
   int obstacleLeft3 =obcordx3+obx3;
    int obstacleTop3 = 465 + 210; // Top coordinate of the obstacle

     int obstacleRight4 = obcordx4 + obx4 + obstacleWidth4; // Rightmost coordinate of the obstacle
   int obstacleLeft4 =obcordx4+obx4;
    int obstacleTop4 = 465 + 210; // Top coordinate of the obstacle

     int obstacleRight5 = obcordx5 + obx5 + obstacleWidth5; // Rightmost coordinate of the obstacle
   int obstacleLeft5 =obcordx5+obx5;
    int obstacleTop5 = 465 + 150; // Top coordinate of the obstacle


    // Check for collision using bounding box collision detection
   if (dinoRight>=obstacleLeft1 || obstacleTop1>=dinoBottom )
       if (dinoRight >= obcordx1 + obx1 && x + x2 + ballx +60<= obcordx1+ obx1 + obstacleWidth1 &&
        dinoBottom >= 500 && y + bally <= obstacleTop1 || dinoRight >= obcordx2 + obx2 && x + x2 + ballx-10 <= obcordx2 + obx2 + obstacleWidth2 &&
        dinoBottom >= 500 && y + bally <= obstacleTop2 || dinoRight >= obcordx3 + obx3 && x + x2 + ballx-10 <= obcordx3 + obx3 + obstacleWidth3 &&
        dinoBottom >= 500 && y + bally <= obstacleTop3 || dinoRight >= obcordx4 + obx4 && x + x2 + ballx-10 <=  obcordx4 + obx4 + obstacleWidth4&&
        dinoBottom >= 500 && y + bally <= obstacleTop4 || dinoRight >= obcordx5 + obx5 && x + x2 + ballx-10 <= obcordx5 + obx5 + obstacleWidth5 &&
        dinoBottom >= 500 && y + bally <= obstacleTop5  )
         {
        return 1; // Collision detected
         }


    return 0; // No collision
}



